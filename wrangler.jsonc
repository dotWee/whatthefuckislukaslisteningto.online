{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatthefuckislukaslisteningto-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/", "/about"],
  },
  "vars": {
    "LASTFM_USER": "Twnksinr",
  },
  "secrets": {
    "required": ["LASTFM_API_KEY"],
  },
  "routes": [
    {
      "pattern": "whatthefuckislukaslisteningto.online",
      "custom_domain": true,
    },
  ],
}
